; Project Zero Climb — first-playtest vertical slice
; Phase 0 foundation. Godot will rewrite/expand this on first editor open.

config_version=5

[application]

config/name="Project Zero Climb"
config/description="Connected-room action roguelite. First-playtest vertical slice."
run/main_scene="res://scenes/playable.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameSettings="*res://scripts/run/game_settings.gd"
SaveService="*res://scripts/run/save_service.gd"
SceneFlow="*res://scripts/run/scene_flow.gd"

[display]

; 1920x1080 reference resolution, aspect preserved on resize.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

; Brief: physics tick 60.
common/physics_ticks_per_second=60

[rendering]

; Pixel actors, icons, and effects must not be filtered.
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0

[importer_defaults]

; Lossless, unfiltered, no mipmaps — preserves the alpha split frames exactly.
texture={
"compress/mode": 0,
"compress/high_quality": false,
"compress/normal_map": 0,
"compress/channel_pack": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false,
"process/premult_alpha": false,
"roughness/mode": 0
}

[layer_names]

; Master guide §15. Fixed 1-10, do not reorder.
3d_physics/layer_1="World"
3d_physics/layer_2="PlayerBody"
3d_physics/layer_3="EnemyBody"
3d_physics/layer_4="PlayerHurtbox"
3d_physics/layer_5="EnemyHurtbox"
3d_physics/layer_6="FriendlyAttack"
3d_physics/layer_7="HostileAttack"
3d_physics/layer_8="PickupInteractable"
3d_physics/layer_9="NavigationBlocker"
3d_physics/layer_10="CameraTrigger"

